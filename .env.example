APP_NAME=PyramidthCRM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

# Comma-separated list, must include the Next.js origin for Sanctum SPA auth
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000
SESSION_DOMAIN=localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pyramidth_crm
DB_USERNAME=pyramidth
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=false
# Explicit so the Next.js middleware's cookie-presence check (a UX
# convenience only, not a security boundary) knows what name to look for.
SESSION_COOKIE=pyramidth_crm_session

QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Google OAuth (Gmail + Calendar) ---
# Server-side only. Never expose to the frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback
GOOGLE_SCOPES="https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/calendar"

# --- Official LinkedIn OAuth (profile scopes only; no scraping) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=${APP_URL}/api/v1/linkedin/callback
LINKEDIN_SCOPES="openid profile email"

# --- Public website research ---
SCRAPER_MAX_PAGES=10
SCRAPER_TIMEOUT=10

# --- AI provider (abstracted behind AiServiceInterface) ---
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.6-flash

# --- Web search provider (abstracted behind WebSearchServiceInterface) ---
WEB_SEARCH_PROVIDER=google
WEB_SEARCH_API_KEY=
WEB_SEARCH_ENGINE_ID=
